# Copy to .env.local for local development (never commit real values).
# On Vercel, set the same variables under Project → Settings → Environment Variables
# for both "Production" and "Preview".

# Supabase → Project Settings → API. The anon/publishable key is designed to be public;
# Row Level Security (supabase/migrations) is what protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Shown on the Privacy page. Use the region you picked when creating the Supabase project.
VITE_DATA_REGION=Frankfurt, Germany (EU)
# Shown on the Privacy page as the contact for data questions (GDPR requires one).
VITE_CONTACT_EMAIL=

# Absolute site URL for canonical links, og:url and sitemap.xml. On Vercel this is detected
# automatically from VERCEL_PROJECT_PRODUCTION_URL, so you only need it elsewhere.
SITE_URL=
