{
  "name": "durar",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Durar (درر) — an immersive 3D Arabic vocabulary experience.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "build:preview-artifact": "vite build --config vite.artifact.config.ts",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "validate:data": "node scripts/validate-words.mjs",
    "test:e2e": "playwright test",
    "test:db": "node --test tests/db/rls.test.mjs"
  },
  "dependencies": {
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.0",
    "@fontsource/markazi-text": "^5.3.0",
    "@react-three/fiber": "^9.3.0",
    "@supabase/supabase-js": "^2.117.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
