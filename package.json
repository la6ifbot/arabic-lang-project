{
  "name": "durar",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Durar (درر) — an immersive 3D Arabic vocabulary experience.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/prerender.mjs",
    "build:preview-artifact": "vite build --config vite.artifact.config.ts",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "validate:data": "tsx scripts/validate-words.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "import:sheet": "node scripts/import-sheet.mjs",
    "export:sheet": "node scripts/export-sheet.mjs",
    "test:e2e": "playwright test",
    "test:db": "node --test --test-concurrency=1 tests/db/rls.test.mjs tests/db/subscriptions.test.mjs tests/db/progress.test.mjs tests/db/monitoring.test.mjs tests/db/deep.test.mjs",
    "test:unit": "vitest run",
    "cards": "tsx scripts/cards.mjs",
    "illustrations": "tsx scripts/illustrations.mjs",
    "check:functions": "tsc -p tsconfig.functions.json && node -e \"Promise.all(['subscribe','confirm','unsubscribe','health','cron/daily','cron/health','cron/weekly'].map(f=>import('./node_modules/.functions-check/api/'+f+'.js').then(m=>{if(typeof (m.POST||m.GET)!=='function')throw new Error(f)}))).then(()=>console.log('functions: all 7 load in plain Node ESM'))\"",
    "email:render": "tsx scripts/email.ts render",
    "email:dry-run": "tsx scripts/email.ts dry-run",
    "email:test": "tsx scripts/email.ts test"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1148.0",
    "@fontsource/aref-ruqaa": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "@supabase/supabase-js": "^2.117.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "22.x"
  }
}
